{
  "name": "pathology-lab-management",
  "version": "1.0.0",
  "private": true,
  "description": "Pathology Laboratory Management System — monorepo root",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "db:reset": "pnpm --filter api db:reset"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "eslint": "^9.15.0"
  }
}
