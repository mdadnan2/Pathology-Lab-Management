# API Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql+psycopg2://postgres:root@localhost:5432/pathlab_db"

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# Cookie
COOKIE_SECRET=change-this-to-another-long-random-secret

# Required by the fictional demo user seed script. Set a local value of at least 12 characters.
DEMO_USER_PASSWORD=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=./uploads
